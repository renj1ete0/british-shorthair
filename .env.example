# Copy to .env in the repository root. docker/docker-compose.yml reads it via env_file,
# and compose commands must pass --env-file .env so ${...} in that file is filled too.
# Docker's env_file parser does not allow spaces around '=' - write KEY=value exactly.

# LTA DataMall API key. Request one at
# https://datamall.lta.gov.sg/content/datamall/en.html
API_KEY=your-datamall-key

# Optional: if you hold several keys and want to spread requests across them, set this
# instead of (or as well as) API_KEY. A JSON array or a comma-separated list both work.
# API_KEY takes precedence when both are present.
# LTA_API_KEYS=["first-key","second-key"]

# Telegram alerting. Create a bot via @BotFather; get the chat id from @userinfobot
# or https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot.
# Leave blank to disable notifications entirely - jobs still run and still log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Published image the server pulls. Must stay PRIVATE: the image contains local-only
# modules that are deliberately not published. GHCR packages are private by default
# and, unlike Docker Hub's free tier, there is no one-private-repo limit and no pull
# rate limit.
BSH_IMAGE=ghcr.io/renj1ete0/british-shorthair:latest

# Credentials Watchtower uses to check that private package for updates.
# Use a GitHub personal access token (classic) with read:packages scope - read-only.
# Without these Watchtower silently never updates the collector.
REGISTRY_USER=renj1ete0
REGISTRY_TOKEN=

# Optional. Where collected data is written on the host. Defaults to ./data at the
# repository root, which is gitignored - leave it unset and everything just works.
#
# Set it when the repository lives inside a synced folder (OneDrive, Dropbox, Google
# Drive), or when you want the data on a larger disk. Collection runs at roughly
# 3.3 GB/day (~1.2 TB/year before archival), which a sync client will try to upload
# continuously and a small root volume will not hold.
# BSH_DATA_PATH=/srv/british-shorthair

# --- Optional tuning; defaults shown ---
# Hard budget for one bus arrival tick. Must stay under the 20s cadence.
# BSH_ARRIVAL_DEADLINE=18
# Concurrent requests during a bus arrival tick. There is no batch endpoint, so a tick
# is ~5,091 individual requests. Sized as stops * latency / deadline; at ~590ms per
# request that needs ~167. Lower this first if LTA starts returning 429 - it is the
# direct lever on the ~255 req/s the 20s cadence implies.
# BSH_ARRIVAL_WORKERS=160
# BSH_ARRIVAL_TIMEOUT=6
# Retry budget for everything except bus arrival, which uses its own tighter policy.
# BSH_RETRY_ATTEMPTS=4
# BSH_RETRY_BASE_DELAY=0.5
# BSH_RETRY_MAX_DELAY=20
